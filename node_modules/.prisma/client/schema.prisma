datasource db {
  provider = "sqlite" // Вы можете заменить на другой провайдер, например, PostgreSQL
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}
